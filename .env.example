# =============================================================================
# Plantilla de variables de entorno - NetAgent-IA (Proyecto 2, Grupo 6)
#
# Uso:
#   cp .env.example .env
#   chmod 600 .env
#   # completar los valores reales del laboratorio
#
# Este archivo SÍ se versiona (no contiene secretos).
# El archivo .env NO se versiona y está excluido en .gitignore.
# =============================================================================

# --- Credenciales SSH del router R1 (MikroTik RouterOS) ----------------------
# Usuario y contraseña definidos por el grupo en el dispositivo real.
NETAGENT_R1_USUARIO=
NETAGENT_R1_CLAVE=

# --- Credenciales SSH del switch SW1 (MikroTik RouterOS) ---------------------
NETAGENT_SW1_USUARIO=
NETAGENT_SW1_CLAVE=

# --- Proveedor de IA ---------------------------------------------------------
# Por defecto se usa Ollama local con qwen3:4b, sin clave de OpenAI.
# NETAGENT_PROVEEDOR=ollama
# NETAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# NETAGENT_OLLAMA_TIMEOUT=120
# NETAGENT_OLLAMA_MAX_TOKENS=1024
# NETAGENT_MODELO=qwen3:4b
# Para OpenAI: NETAGENT_PROVEEDOR=openai; si se configura NETAGENT_MODELO,
# seleccione también un modelo compatible de OpenAI. La clave solo es necesaria
# con OpenAI.
OPENAI_API_KEY=

# --- Parámetros opcionales del agente ---------------------------------------
# Máximo de mensajes procesados por sesión.
# NETAGENT_MAX_PASOS=12
# Máximo de llamadas a herramientas por solicitud, incluida la verificación.
# NETAGENT_MAX_HERRAMIENTAS=6
# Exigir aprobación humana antes de cada modificación (mantener en true).
# NETAGENT_REQUIERE_APROBACION=true
