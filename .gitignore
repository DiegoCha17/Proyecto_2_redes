# --- Secretos (NUNCA versionar) ---
.env
.env.*
!.env.example

# --- Entorno virtual de Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Registros de sesión (evidencia local, no se versiona) ---
registros/*
!registros/.gitkeep

# --- Ansible ---
*.retry
.ansible/
ansible/inventario.ini.bak
ansible/vault/vault.yml
ansible/vault/vault.yml.*
ansible/vault/*.yml
ansible/vault/*.yaml
ansible/vault/*.yml.*
ansible/vault/*.yaml.*
ansible/vault/.vault-config-*/
.vault-pass
.vault_password

# --- Editores ---
.vscode/
.idea/
*.swp
